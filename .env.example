# --- Mezon Bot Configuration ---
MEZON_BOT_ID=
MEZON_TOKEN=

# Optional gateway connection overrides (defaults to production gateway)
MEZON_HOST=gw.mezon.ai
MEZON_PORT=443
MEZON_USE_SSL=true

# Destination:
# MEZON_CHANNEL_ID (or MEZON_FUND_CHANNEL_ID) is the parent channel in your clan.
# MEZON_THREAD_ID is the specific thread ID to which the bot posts fund transaction updates.
# If MEZON_THREAD_ID is left empty, the bot can auto-create or find a thread named MEZON_THREAD_NAME under MEZON_CHANNEL_ID.
MEZON_CHANNEL_ID=
MEZON_FUND_CHANNEL_ID=
MEZON_THREAD_ID=
MEZON_THREAD_NAME=Biến động quỹ

# --- Mezon Đồng Blockchain & Indexer Settings ---
# The mmn node gRPC address streaming all on-chain transactions.
# Use hostname dong.mezon.ai:443 for valid TLS certificate verification.
MMN_NODE_ENDPOINT=dong.mezon.ai:443
MMN_NODE_TLS=true

# The donation campaign wallet address to watch for movements (incoming and outgoing).
DONATION_WALLET_ADDRESS=

# Decimals for Mezon Đồng (default 6: 1 MMN = 1,000,000 micro-tokens).
MMN_TOKEN_DECIMALS=6

# The indexer REST API URL to fetch the current wallet balance.
MEZON_MAINNET_API_URL=https://dong.mezon.ai/indexer-api
MMN_CHAIN_ID=1337

# Timezone for transaction announcement timestamps (default: Vietnam GMT+7).
TIMEZONE=Asia/Ho_Chi_Minh

# --- Application Runtime ---
# Outbox sweep interval in seconds (default 30).
COURIER_INTERVAL=30
LOG_LEVEL=info
